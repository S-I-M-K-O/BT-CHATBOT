# HERMES runs fully local: chat via Ollama, speech via Piper.
# No API keys required for the base features.

# Ollama for `go run ./cmd/hermes` on the host. Default: http://localhost:11434
# OLLAMA_BASE=http://localhost:11434
# Ollama as seen from the Docker container (docker-compose only). Default:
# http://host.docker.internal:11434, resolved via extra_hosts. On Linux, Ollama
# must listen beyond 127.0.0.1 for this to work; see the README.
# DOCKER_OLLAMA_BASE=http://host.docker.internal:11434

# --- Optional: Mistral AI for real-time data + image generation ---
# When set, HERMES routes weather / time / news questions to Mistral's
# function-calling API, and picture requests to Mistral's image generation.
# Without this key everything falls back to the local Ollama model.
MISTRAL_API_KEY=

# Model used for the Mistral real-time + image agent. Default:
# mistral-medium-latest
MISTRAL_MODEL=mistral-medium-latest

# --- Optional overrides (defaults shown) ---
# Bind address (docker-compose uses 0.0.0.0) and port. A non-loopback ADDR
# needs HERMES_TOKEN (below) for other devices to get in.
# ADDR=127.0.0.1
# PORT=8080
# Settings file; ./settings.json from older versions is still read once.
# SETTINGS_FILE=data/settings.json
# hermes.conf: plain-text settings that win over the Settings window (no
# secrets). Default: hermes.conf next to the settings file (data/hermes.conf,
# /app/data/hermes.conf in Docker). See README → Configuration.
# HERMES_CONFIG=data/hermes.conf
# Generated / searched images, pruned after 24 hours.
# GEN_DIR=data/gen
# Piper TTS binary and voice models. Without Piper, use the browser voice.
# PIPER_BIN=piper
# VOICE_DIR=voices
# STATIC_DIR=static

# Docker only: host uid/gid the container runs as, so files in ./data stay
# yours (default 1000:1000; Linux: `id -u` / `id -g`). Not UID/GID: bash's UID
# is read-only and never reaches Compose.
# HERMES_UID=1000
# HERMES_GID=1000

# --- Network access (LAN) ---
# Requests from this machine via localhost / 127.0.0.1 / ::1 need nothing.
# Anything else (an IP or a hostname from another device) must carry this
# token, because the API can rewrite the system prompt and spend the Mistral
# key. Leave it empty and HERMES refuses non-local requests. Generate one with
# `openssl rand -hex 32`, then open http://<host>:8080/?token=<token> once per
# browser (stored as a cookie), or send "Authorization: Bearer <token>".
HERMES_TOKEN=

# Extra hostnames allowed in the Host header (DNS-rebinding guard). IPs and
# localhost always work. Non-loopback names still need HERMES_TOKEN.
# Example: ALLOWED_HOSTS=hermes.lan,pi.local
ALLOWED_HOSTS=

# Scoped token for phones: opens only /lists.html and the list API
# (http://<host>:8080/lists.html?token=<this>). Give it to family members
# instead of HERMES_TOKEN. Docker: only with docker-compose.lan.yml.
# HERMES_LISTS_TOKEN=

# Docker only, set by docker-compose: the published port is bound to
# 127.0.0.1, so a localhost request arriving from the bridge gateway is local.
# docker-compose.lan.yml sets it to 0. HERMES refuses to start when it is 1
# together with HERMES_LISTS_TOKEN or a LAN hostname in ALLOWED_HOSTS.
# Only a connection from the container's default gateway (where Docker's port
# proxy connects from) counts; other containers need the token.
# HERMES_BEHIND_LOOPBACK=1
# Extra peer IPs (comma-separated) that count as "this machine" with
# HERMES_BEHIND_LOOPBACK=1, for unusual Docker setups where the published port
# is not proxied from the gateway. Normally leave it empty.
# HERMES_TRUSTED_PEER=
# Turns the token check off entirely (old behaviour). Only for a reverse proxy
# that authenticates on its own.
# HERMES_INSECURE_NO_TOKEN=1

# --- Companion features (all optional) ---
# Where people, memories, reminders, lists and other state live (0600 files).
# DATA_DIR=data
# Household time zone fallback (Settings → Ort & Zeit wins). Docker sets TZ.
# HERMES_TZ=Europe/Berlin
# Credentials can be stored from the UI (Settings, only from this Mac at
# http://localhost:8080) in data/secrets.json (0600) or set here. Each env
# variable overrides only its own field; the UI then shows it as "from .env".
#
# Home Assistant (README → Smart Home): http(s)://host[:port], no path. Use the
# LAN IP, not homeassistant.local (mDNS does not resolve inside Docker).
# Precedence: HA_URL / HA_TOKEN here win over the Settings window, each field
# on its own. With HA_URL set here, a token saved in the UI is used only if it
# was saved for this same URL; changing the URL in the UI clears the stored
# token. The token: a long-lived token of a dedicated non-admin HA user.
# HA_URL=http://192.168.1.20:8123
# HA_TOKEN=
#
# Google Calendar OAuth client, type "Desktop app" (README → Calendar). A new
# client id (here or in the UI) clears a stored secret and requires connecting
# the calendar again; a new secret alone keeps the link. Connect from
# http://localhost:8080 on this machine.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# The household PIN (Settings → Privacy) has no env variable. Changing or
# removing it locks every device; removing it also turns the personal lock off.
# Documents: a folder of .md/.txt notes HERMES can answer from (read-only,
# rescanned every 10 minutes; .pdf only with pdftotext installed). Uploaded
# documents live in DATA_DIR/docs either way. Docker: mount it read-only.
# HERMES_DOCS_DIR=
# Read a link: extra address ranges that must never be fetched, comma-separated
# (Docker: your LAN prefixes, including IPv6; the container cannot see them).
# HERMES_BLOCK_CIDRS=192.168.1.0/24,2a02:db8:1::/64
# Debug logging: voice-ID match scores; the number and roles (never the
# content) of messages sent to Mistral; per-turn latency.
# HERMES_DEBUG_VOICEID=1
# HERMES_DEBUG_MISTRAL=1
# HERMES_DEBUG_TIMING=1
